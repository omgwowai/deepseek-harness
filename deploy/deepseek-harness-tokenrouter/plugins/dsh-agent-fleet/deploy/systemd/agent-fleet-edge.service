# Edge router on 10.0.60.98:443 (system unit: 443 is privileged). /fleet → hub, /dsh → DSH Web,
# everything else → the TRTA v4 telemetry panel, moved to 127.0.0.1:8464 by the drop-in in this directory.
# Placeholders: @@F@@ = plugin dir on the server, @@NODE@@ = node ≥ 22.15.
[Unit]
Description=Agent Fleet edge router (10.0.60.98:443 → fleet hub, DSH Web, telemetry panel)
After=network-online.target trta-v4-panel-http443.service
Wants=network-online.target

[Service]
Type=simple
User=bochao_li
ExecStart=@@NODE@@ @@F@@/bin/agent-fleet.mjs edge --listen 10.0.60.98:443 --route /fleet=http://127.0.0.1:7840 --route /dsh=http://127.0.0.1:3080 --fallback http://127.0.0.1:8464
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
